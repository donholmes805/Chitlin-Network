rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isAuthenticated() && (
        getUserData().role == role || 
        request.auth.token.email == "donholmes805@gmail.com"
      );
    }
    
    function isOwner() {
      return isAuthenticated() && (
        getUserData().role == "owner" || 
        request.auth.token.email == "donholmes805@gmail.com"
      );
    }
    
    function isAdmin() {
      return isOwner() || hasRole("admin");
    }

    // --- Users ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        request.auth.uid == userId || isAdmin()
      ) && (
        // Only Admins/Owners can change roles
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) || isAdmin()
      );
    }

    // --- Channels ---
    match /channels/{channelId} {
      allow read: if true; // Public can see channels
      allow create: if isAdmin(); // Only admins can create channels for now or application process
      allow update: if isAdmin() || (
        isAuthenticated() && resource.data.ownerId == request.auth.uid
      );
    }

    // --- Shows & Episodes ---
    match /shows/{showId} {
      allow read: if true;
      allow create: if isAuthenticated(); // Role check should be in service/functions but for now...
      allow update, delete: if isAdmin() || (
        isAuthenticated() && resource.data.ownerId == request.auth.uid
      );
    }

    match /episodes/{episodeId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    // --- Revenue Ledger ---
    match /revenueLedger/{recordId} {
      allow read: if isAdmin() || (
        isAuthenticated() && resource.data.ownerId == request.auth.uid
      );
      allow write: if isAdmin(); // Channel owners cannot write to the ledger
    }

    // --- Platform Settings ---
    match /platformSettings/{settingId} {
      allow read: if true;
      allow write: if isOwner();
    }
    
    // --- Global Catch-all for Admin ---
    match /{allPaths=**} {
      allow read, write: if isOwner();
    }
  }
}
