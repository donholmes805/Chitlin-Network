rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isAuthenticated() && (
        getUserData().role == role || 
        request.auth.token.email == "donholmes805@gmail.com"
      );
    }
    
    function isOwner() {
      return isAuthenticated() && (
        getUserData().role == "owner" || 
        request.auth.token.email == "donholmes805@gmail.com"
      );
    }
    
    function isAdmin() {
      return isOwner() || hasRole("admin");
    }

    function isApproved(resource) {
      return resource.data.status == "approved";
    }

    // --- Users ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        request.auth.uid == userId || isAdmin()
      ) && (
        // Only Admins/Owners can change roles
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) || isAdmin()
      );
    }

    // --- Channels ---
    match /channels/{channelId} {
      allow read: if resource.data.status == "approved" || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() && resource.data.ownerId == request.auth.token.email
      );
    }

    // --- Shows & Episodes ---
    match /shows/{showId} {
      allow read: if resource.data.status == "approved" || isAdmin() || (isAuthenticated() && resource.data.ownerId == request.auth.token.email);
      allow create: if isAdmin() || hasRole("channel_owner");
      allow update, delete: if isAdmin() || (
        isAuthenticated() && resource.data.ownerId == request.auth.token.email
      );
    }

    match /episodes/{episodeId} {
      allow read: if resource.data.status == "approved" || isAdmin() || (isAuthenticated() && resource.data.ownerId == request.auth.token.email);
      allow create: if isAdmin() || hasRole("channel_owner");
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.ownerId == request.auth.token.email);
    }

    // --- Schedules ---
    match /schedules/{scheduleId} {
      allow read: if resource.data.status == "approved" || isAdmin() || (isAuthenticated() && resource.data.ownerId == request.auth.token.email);
      allow create, update, delete: if isAdmin() || (isAuthenticated() && resource.data.ownerId == request.auth.token.email && hasRole("channel_owner"));
    }

    // --- Ads ---
    match /ads/{adId} {
      allow read: if resource.data.status in ["approved", "active"] || isAdmin() || (isAuthenticated() && resource.data.ownerId == request.auth.token.email);
      allow create, update, delete: if isAdmin() || (isAuthenticated() && resource.data.ownerId == request.auth.token.email && hasRole("channel_owner"));
    }

    // --- Live Events ---
    match /liveEvents/{liveEventId} {
      // Public can only read live events that are actively live (public-safe fields only)
      allow read: if resource.data.status == "live" || isAdmin() || (isAuthenticated() && resource.data.ownerId == request.auth.token.email);
      allow create, update, delete: if isAdmin() || (isAuthenticated() && resource.data.ownerId == request.auth.token.email && hasRole("channel_owner"));

      // Private ingest credentials (never public)
      match /private/{docId} {
        allow read, write: if isAdmin() || (isAuthenticated() && get(/databases/$(database)/documents/liveEvents/$(liveEventId)).data.ownerId == request.auth.token.email);
      }
    }

    // --- Ad Orders ---
    match /adOrders/{orderId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.email == request.auth.token.email);
      allow create: if true; // public checkout creates pending orders (Stripe webhook will finalize)
      allow update, delete: if isAdmin();
    }

    // --- Revenue Ledger ---
    match /revenueLedger/{recordId} {
      allow read: if isAdmin() || (
        isAuthenticated() && resource.data.ownerId == request.auth.token.email
      );
      allow write: if isAdmin(); // Channel owners cannot write to the ledger
    }

    // --- Platform Settings ---
    match /platformSettings/{settingId} {
      allow read: if true;
      allow write: if isOwner();
    }
    
    // --- Global Catch-all for Owner ---
    match /{allPaths=**} {
      allow read, write: if isOwner();
    }
  }
}
